SQL Constraints Explanation with Sample Table

1. PRIMARY KEY
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50)
);

INSERT INTO STUDENT VALUES
(101, 'Arun');

2. NOT NULL
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50) NOT NULL
);

INSERT INTO STUDENT
VALUES (101, 'Arun');

3. UNIQUE
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50),
Email VARCHAR(100) UNIQUE
);

INSERT INTO STUDENT
VALUES (101, 'Arun', 'arun@gmail.com');

4. CHECK
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50),
Age INT CHECK (Age >= 18)
);

INSERT INTO STUDENT
VALUES (101, 'Arun', 20);

5. DEFAULT
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50),
City VARCHAR(30) DEFAULT 'Chennai'
);

INSERT INTO STUDENT
(Student_ID, Name)
VALUES (101, 'Arun');

6. FOREIGN KEY
Parent Table DEPARTMENT
CREATE TABLE DEPARTMENT
(
Dept_ID INT PRIMARY KEY,
Dept_Name VARCHAR(30)
);

INSERT INTO DEPARTMENT VALUES
(1, 'CSE'),
(2, 'ECE'),
(3, 'IT');

Child Table STUDENT
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50),
Dept_ID INT,
FOREIGN KEY (Dept_ID)
REFERENCES DEPARTMENT(Dept_ID)
);

INSERT INTO STUDENT
VALUES (101, 'Arun', 1);



7.EXAMPLE PROGRAM:
CREATE TABLE STUDENT
(
Student_ID INT PRIMARY KEY,
Name VARCHAR(50) NOT NULL,
Email VARCHAR(100) UNIQUE,
Age INT CHECK (Age >= 18),
City VARCHAR(30) DEFAULT 'Chennai',
Dept_ID INT,
FOREIGN KEY (Dept_ID)
REFERENCES DEPARTMENT(Dept_ID)
);

