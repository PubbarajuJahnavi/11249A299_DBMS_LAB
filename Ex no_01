1.CREATING A TABLE
CREATE TABLE STUDENT
(
STUDENT_ID INT PRIMARY KEY,
NAME VARCHAR(50),
DEPARTMENT VARCHAR(30),
YEAR INT,
MARKS INT
);

2.DESCRIBE TABLE
DESC STUDENT;

3.RETRIEVE ALL RECORDS
SELECT * FROM STUDENT;

4.RETRIEVE SELECTED COLUMNS
SELECT NAME,MARKS
FROM STUDENT;

5.RETRIEVE RECORDS USING WHERE CLASS
SELECT *
FROM STUDENT
WHERE DEPARTMENT='CSE';

6.RETRIEVE USING ORDER BY
SELECT *
FROM STUDENT
ORDER BY MARKS DESC;

7.DISTINCT
SELECT DISTINCT DEPARTMENT
FROM STUDENT;

